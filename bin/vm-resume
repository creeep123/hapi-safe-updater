#!/usr/bin/env bash
set -Eeuo pipefail
systemctl --user start hapi-hub.service
for _ in $(seq 1 60); do
  if curl -fsS --max-time 2 http://127.0.0.1:8080/health >/dev/null 2>&1; then break; fi
  sleep 1
done
curl -fsS --max-time 5 http://127.0.0.1:8080/health >/dev/null
systemctl --user start hapi-runner.service
systemctl --user is-active --quiet hapi-hub.service
systemctl --user is-active --quiet hapi-runner.service
