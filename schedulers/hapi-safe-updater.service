[Unit]
Description=Safely update HAPI when no agent task is executing
After=network-online.target

[Service]
Type=oneshot
ExecStart=__ROOT__/bin/scheduled-run
Environment=NODE_OPTIONS=--max-old-space-size=1536
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=150%
# Keep source builds from competing with production HAPI until global OOM.
# Percentage limits scale with the host; exceeding them kills only this oneshot.
MemoryAccounting=true
MemoryHigh=40%
MemoryMax=50%
MemorySwapMax=10%
OOMPolicy=stop
OOMScoreAdjust=500
TimeoutStartSec=45min
